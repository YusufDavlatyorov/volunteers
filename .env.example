# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django core ---
# REQUIRED — the app raises ImproperlyConfigured at startup without it (no
# insecure built-in fallback). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# Defaults to False if unset. Set True only for local development.
DJANGO_DEBUG=True
# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,example.com
# Defaults to localhost,127.0.0.1 if unset. A "*" wildcard is refused at
# startup once DJANGO_DEBUG=False — list your real production host(s) instead.
# Local dev (default, no value needed):
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production:
#   DJANGO_ALLOWED_HOSTS=khayrkhokh.tj,www.khayrkhokh.tj
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins (scheme://host[:port]) allowed to send POST/PUT/…
# requests. Django 4+ needs the production HTTPS origin(s) here or CSRF fails.
# Production:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://khayrkhokh.tj,https://www.khayrkhokh.tj
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set True ONLY when running behind a TLS-terminating reverse proxy (nginx/Caddy)
# that is trusted to set X-Forwarded-Proto. Without it, SECURE_SSL_REDIRECT would
# loop forever behind the proxy; setting it when NOT behind such a proxy lets a
# client spoof HTTPS. Leave blank/False for local dev and for direct-TLS setups.
DJANGO_BEHIND_TLS_PROXY=False
# Logging verbosity for the app's own loggers (myapp / accounts): DEBUG/INFO/WARNING/ERROR.
DJANGO_LOG_LEVEL=INFO

# --- Database ---
# SQLite is the default (no settings needed) — fine for local dev and for the
# test suite. Production MUST use PostgreSQL: set DJANGO_DB_NAME (and the rest
# below) and the engine switches automatically, no code change. Requires
# `psycopg[binary]` (already in requirements.txt).
#
# This project has no single DATABASE_URL variable — it takes the same
# connection info as discrete DJANGO_DB_* fields instead (equivalent to
# DATABASE_URL=postgresql://DJANGO_DB_USER:DJANGO_DB_PASSWORD@DJANGO_DB_HOST:DJANGO_DB_PORT/DJANGO_DB_NAME).
#
# Local dev: leave all four blank — SQLite is used automatically. DO NOT put
# the placeholders below in a real .env unless you are actually configuring
# PostgreSQL; a non-empty DJANGO_DB_NAME switches the engine immediately.
#
# Production: fill in the real shared-PostgreSQL credentials —
# placeholders only below, replace every YOUR_… value, never commit the real
# ones:
#   DJANGO_DB_NAME=YOUR_POSTGRES_DATABASE
#   DJANGO_DB_USER=YOUR_POSTGRES_USERNAME
#   DJANGO_DB_PASSWORD=YOUR_POSTGRES_PASSWORD
#   DJANGO_DB_HOST=shared_postgres
#   DJANGO_DB_PORT=5432
# DJANGO_DB_HOST is the shared PostgreSQL container's service name on the
# shared Docker network in Docker deployments (e.g. shared_postgres);
# bare-metal/VM deployments use the real DB host instead.
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --- Cache / rate limiting ---
# The login / password-reset / AI-assistant / Telegram-link throttles are backed
# by the cache. The default per-process LocMemCache does NOT span gunicorn
# workers — set DJANGO_DB_CACHE=True for a shared, dependency-free DB cache
# (run `python manage.py createcachetable` once) or configure Redis/Memcached.
DJANGO_DB_CACHE=False

# --- Email (SMTP) ---
# Leave SMTP_USER / SMTP_PASSWORD blank to fall back to the console email backend
# (emails are printed to the terminal instead of being sent).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Seconds a single synchronous SMTP send may take before it is abandoned. Django
# has no default here; without it a hung mail server blocks the request/worker.
EMAIL_TIMEOUT=10

# --- AI assistant (Groq, OpenAI-compatible API — NOT Gemini/Google/OpenAI) ---
# Get a key at https://console.groq.com — must be a real Groq key (starts with
# "gsk_"). Do not put a Gemini/Google key here; Groq will reject it with a 401.
# GROQ_API_KEY is the ONLY credential this project reads for the AI assistant
# — there is deliberately no Gemini/Google fallback anywhere in the code
# (server/settings.py reads only GROQ_API_KEY; see CLAUDE.md).
GROQ_API_KEY=your-groq-api-key-here
# Both model IDs below were confirmed live against this account's actual
# model catalog (GET /openai/v1/models) on 2026-09-30 — both return 200 and
# correctly perform tool-calling. Check Groq's current model catalog
# (console.groq.com, or GET /openai/v1/models with your key) if either starts
# returning 404 model_not_found — Groq retires/varies model availability
# over time and by account; do not guess a replacement, verify it first.
GROQ_MODEL=openai/gpt-oss-20b
# Model for the role-based operational assistant — needs reliable tool-calling.
# Falls back to GROQ_MODEL on error. Without any key the assistant returns a
# canned "temporarily unavailable" message.
GROQ_ASSISTANT_MODEL=qwen/qwen3.8-27b

# --- Telegram bot (optional) ---
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# The bot's public @username (without the @), e.g. KhayrKhohBot. Shown
# in the "Link Telegram" instructions so users know which chat to message.
TELEGRAM_BOT_USERNAME=

# --- Maps ---
# Provider for tiles / routing / geocoding, resolved in myapp/services/maps.py:
#   osm     (default) — free Leaflet + OpenStreetMap, self-hostable OSRM, Nominatim. No key.
#   mapbox / google   — drop-in; MAPS_API_KEY is then required.
MAPS_PROVIDER=osm
# Only needed for MAPS_PROVIDER=mapbox|google. Leave blank for osm.
MAPS_API_KEY=
# OSRM routing endpoint used by the `osm` provider. The public demo below is
# rate-limited and NOT for production — self-host OSRM or point at a paid
# routing provider before going live.
OSRM_BASE_URL=https://router.project-osrm.org
# Required by OpenStreetMap's Nominatim usage policy for geocoding requests
# (identifies the app, not a secret). Set real contact info before production:
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=khayrkhokh-dev (contact: set-a-real-email@example.com)

# --- Initial production accounts (see: create_initial_production_accounts) ---
# Used ONLY by `python manage.py create_initial_production_accounts` — an
# idempotent, one-time bootstrap for exactly 4 accounts (admin/curator/
# volunteer/client) on a fresh production database. Leave blank for local dev
# (the command refuses to run with missing email/password — it never invents
# credentials). Usernames default to admin/curator/volunteer/client if the
# *_USERNAME vars are left unset; regions default to "dushanbe" if the
# *_REGION vars are left unset. Passwords go through Django's normal
# AUTH_PASSWORD_VALIDATORS and are hashed the normal way — never logged.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

INITIAL_CURATOR_USERNAME=
INITIAL_CURATOR_EMAIL=
INITIAL_CURATOR_PASSWORD=
INITIAL_CURATOR_REGION=

INITIAL_VOLUNTEER_USERNAME=
INITIAL_VOLUNTEER_EMAIL=
INITIAL_VOLUNTEER_PASSWORD=
INITIAL_VOLUNTEER_REGION=

INITIAL_CLIENT_USERNAME=
INITIAL_CLIENT_EMAIL=
INITIAL_CLIENT_PASSWORD=
INITIAL_CLIENT_REGION=

# --- Docker (production) ---
# Name of the pre-existing external Docker network that the shared
# PostgreSQL container (DJANGO_DB_HOST above) is attached to. This project's
# docker-compose.yml joins that network rather than running its own database
# container. Must match the real network name on the deployment host — ask
# whoever manages shared_postgres if unsure.
SHARED_POSTGRES_NETWORK=shared_postgres_net
