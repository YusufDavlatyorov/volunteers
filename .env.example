# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django core ---
# REQUIRED — the app raises ImproperlyConfigured at startup without it (no
# insecure built-in fallback). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# Defaults to False if unset. Set True only for local development.
DJANGO_DEBUG=True
# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,example.com
# Defaults to localhost,127.0.0.1 if unset. A "*" wildcard is refused at
# startup once DJANGO_DEBUG=False — list your real production host(s) instead.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (SMTP) ---
# Leave SMTP_USER / SMTP_PASSWORD blank to fall back to the console email backend
# (emails are printed to the terminal instead of being sent).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- AI assistant (Groq, OpenAI-compatible API) ---
# Get a key at https://console.groq.com . The app also accepts it under GROQ_API_KEY.
GEMINI_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# --- Telegram bot (optional) ---
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# The bot's public @username (without the @), e.g. GenerationConnectBot. Shown
# in the "Link Telegram" instructions so users know which chat to message.
TELEGRAM_BOT_USERNAME=

# --- Maps / routing (Leaflet + OpenStreetMap, no API key required) ---
# Public OSRM demo server used for turn-by-turn routing in development. It is
# rate-limited and NOT for production use — self-host OSRM or point this at a
# paid routing provider (e.g. OpenRouteService) before going live.
OSRM_BASE_URL=https://router.project-osrm.org
# Required by OpenStreetMap's Nominatim usage policy for any geocoding
# requests (identifies the app, not a secret). Set it to your own contact
# info before production use: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=generation-connect-dev (contact: set-a-real-email@example.com)
